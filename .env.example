# 数据库（应用侧，asyncpg 驱动）
DATABASE_URL=postgresql+asyncpg://aegis:aegis_dev_pw@127.0.0.1:5432/aegis

# LangGraph checkpointer（psycopg 驱动，M2 起用）
CHECKPOINT_DATABASE_URL=postgresql://aegis:aegis_dev_pw@127.0.0.1:5432/aegis

# Redis：应用用 db0；测试固定连 db1 隔离（conftest 里写死，不走本变量）
REDIS_URL=redis://127.0.0.1:6379/0

# LLM（M1 起用；真实密钥只进本机 .env，绝不入库）
DASHSCOPE_API_KEY=
AEGIS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 全 fake 开关：1=零真实 LLM 调用（测试与压测线 B 共用此机制）
AEGIS_FAKE_LLM=1